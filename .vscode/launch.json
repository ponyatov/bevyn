{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "rust:linux",
            "cargo": {
                "args": [
                    "build",
                    "--features=pc",
                    "--target=x86_64-unknown-linux-gnu",
                    "--bin=${workspaceFolderBasename}",
                    "--package=${workspaceFolderBasename}"
                ]
            },
            "args": ["1024", "768"],
            "cwd": "${workspaceFolder}",
            // "stopOnEntry": true,
            "preLaunchTask": "cargo: build",
            "preRunCommands": [
                "process launch --stop-at-entry"
            ]
        },
    ]
}
